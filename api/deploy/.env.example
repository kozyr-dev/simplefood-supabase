# /opt/simplefood-api/.env: read by Compose itself (compose.yaml), not by the API.
# chmod 600. See deploy/README.md.

# The database password, used by Postgres and the API. Generate it once:
#   openssl rand -hex 32
# Postgres reads it only on its first start (empty volume); changing it later
# also needs ALTER USER in the database.
POSTGRES_PASSWORD=

# The API image. deploy.sh writes it after each deploy; leave it empty.
API_IMAGE=

# Optional: the API's port on 127.0.0.1 (default 1339).
# API_PORT=1339
