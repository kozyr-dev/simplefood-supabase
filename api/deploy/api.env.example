# /opt/simplefood-api/api.env: the API's settings in production (chmod 600).
# All of them are validated at start (src/config/env.validation.ts): a wrong or
# missing value stops the API with a message naming it.
# Values exactly as written: no quotes, no $ substitution (format: raw).
# Not here: NODE_ENV, PORT, UPLOADS_DIR, ADMIN_DIST_DIR (set in the image) and
# DB_* (set in compose.yaml).

# The site, for CORS and for links in emails.
CORS_ORIGINS=https://simplefood.kozyr.info
FRONTEND_URL=https://simplefood.kozyr.info

# nginx in front: the client address is one hop back in X-Forwarded-For. The
# website's server calls 127.0.0.1:1339 directly and sets the header itself.
TRUST_PROXY_HOPS=1

# Off in production: the docs list the whole API surface.
SWAGGER_ENABLED=false

# Access tokens' signing key. Generate it once: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Mail (Mailgun): the sending domain's SMTP login, STARTTLS on 587.
# smtp.eu.mailgun.org for a domain in Mailgun's EU region.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A bare address on the sending domain; the code adds the name "SimpleFood".
MAIL_FROM=no-reply@mg.kozyr.info
# The shop's inbox: new orders and contact messages.
MAIL_NOTIFY_TO=

# Optional, with their defaults:
# LOG_LEVEL=info
# JWT_ACCESS_TTL=900
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_TOKEN_MAX_TTL_DAYS=30
# BCRYPT_ROUNDS=12
