# Copy to .env and adjust. .env is gitignored.

# --- Docker Compose (local infrastructure only; not read by the API) ---
POSTGRES_USER=simplefood
POSTGRES_PASSWORD=simplefood
POSTGRES_DB=simplefood
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (validated in src/config/env.validation.ts) ---
NODE_ENV=development
PORT=1339
# Optional. fatal | error | warn | info | debug | trace | silent.
# Leave unset to use the per-NODE_ENV default (test: silent, development: debug,
# production: info); setting it here would also apply to the e2e tests.
# LOG_LEVEL=debug
DB_HOST=localhost
DB_PORT=5433
DB_USER=simplefood
DB_PASSWORD=simplefood
DB_NAME=simplefood
CORS_ORIGINS=http://localhost:3000
# Swagger UI at /api/docs. Off when unset; keep it off in production.
SWAGGER_ENABLED=true

# Auth. The secret below is for local development only; production refuses it.
# Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me
# Defaults: access token 900 s, refresh token 7 days idle / 30 days max, bcrypt cost 12.
# JWT_ACCESS_TTL=900
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_TOKEN_MAX_TTL_DAYS=30
# BCRYPT_ROUNDS=12
# Reverse proxies in front of the API (0 locally: X-Forwarded-For is ignored).
TRUST_PROXY_HOPS=0

# Mail. Locally everything goes to Mailpit (docker compose): http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# Defaults: port 587, STARTTLS (SMTP_SECURE=false; true for port 465), no login.
# Production must offer TLS one way or the other; set both or neither:
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
# The shop's inbox: new orders and contact messages.
MAIL_NOTIFY_TO=shop@example.com
# The site, for links in emails (https in production).
FRONTEND_URL=http://localhost:3000
# Where uploaded images are stored, served at /uploads (default: ./uploads).
# UPLOADS_DIR=uploads
# The built admin app, served at /admin when it exists (cd admin && npm run build).
# ADMIN_DIST_DIR=admin/dist
